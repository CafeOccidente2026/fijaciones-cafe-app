# Database
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/nombre_db?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=tu_secreto_access_muy_largo_aqui
JWT_REFRESH_SECRET=tu_secreto_refresh_muy_largo_aqui
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10

# Public origin used to build absolute URLs for uploaded profile photos.
# Optional: if unset it's derived from the incoming request. Set it to your
# LAN IP when testing on a phone, e.g. http://192.168.1.13:4000
# PUBLIC_BASE_URL=http://192.168.1.13:4000

# Initial admin (used only by the seed script)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ContrasenaTemporal123*
SEED_ADMIN_FULLNAME=Administrador Principal