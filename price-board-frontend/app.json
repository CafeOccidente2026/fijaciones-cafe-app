{
  "expo": {
    "name": "Fijaciones",
    "slug": "fijaciones-cafe",
    "version": "1.0.0",
    "scheme": "priceboard",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para elegir una imagen de perfil.",
          "cameraPermission": "La app necesita acceso a la cámara para tomar tu foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6E1423"
        }
      ]
    ],
    "icon": "./assets/new-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EFE3D0",
        "foregroundImage": "./assets/new-adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.cafeoccidentesteam.fijacionescafe"
    },
    "web": {
      "favicon": "./assets/new-favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e9bd55a-5f3e-459e-a8e4-ccfd1649c43b"
      }
    },
    "owner": "cafeoccidentes-team"
  }
}
